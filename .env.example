# PostgreSQL Database Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brightloop?schema=public"

# NextAuth / Auth Session Secret (Generate with `openssl rand -base64 32`)
NEXTAUTH_SECRET="super-secret-random-key-at-least-32-characters"
NEXTAUTH_URL="http://localhost:3000"

# Application Environment
NODE_ENV="development"

# Automated Cron & Billing Engine API Secret
CRON_SECRET="brightloop-super-secure-billing-cron-token-123456"
