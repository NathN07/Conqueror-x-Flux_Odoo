generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum BillingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum PlanStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum DiscountType {
  FIXED
  PERCENT
}

enum DiscountAppliesTo {
  PRODUCT
  SUBSCRIPTION
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum PaymentMethod {
  CARD
  UPI
  BANK
  CASH
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  role             Role              @default(CUSTOMER)
  name             String
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  customerProfile  CustomerProfile?
  subscriptionsCreated Subscription[] @relation("SubscriptionCreator")
  statusChanges    SubscriptionStatusHistory[] @relation("StatusChangedBy")
  paymentsRecorded Payment[]         @relation("PaymentRecorder")
  customerSubscriptions Subscription[] @relation("CustomerSubscriptions")
  customerInvoices Invoice[]         @relation("CustomerInvoices")

  @@map("users")
}

model CustomerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String?
  company   String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customer_profiles")
}

model Product {
  id         String           @id @default(cuid())
  name       String
  type       String           @default("service")
  salesPrice Decimal          @db.Decimal(12, 2)
  costPrice  Decimal          @db.Decimal(12, 2)
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  variants          ProductVariant[]
  subscriptionLines SubscriptionLine[]
  quotationLines    QuotationTemplateLine[]
  discounts         Discount[]

  @@map("products")
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute  String
  value      String
  extraPrice Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  subscriptionLines SubscriptionLine[]
  quotationLines    QuotationTemplateLine[]

  @@map("product_variants")
}

model Plan {
  id              String        @id @default(cuid())
  name            String
  price           Decimal       @db.Decimal(12, 2)
  billingPeriod   BillingPeriod
  minQuantity     Int           @default(1)
  availableFrom   DateTime?
  availableTo     DateTime?
  autoClose       Boolean       @default(false)
  allowEarlyClose Boolean       @default(false)
  allowPause      Boolean       @default(false)
  allowRenew      Boolean       @default(true)
  status          PlanStatus    @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  subscriptions      Subscription[]
  quotationTemplates QuotationTemplate[]

  @@map("plans")
}

model Tax {
  id        String   @id @default(cuid())
  name      String
  percent   Decimal  @db.Decimal(12, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptionLines SubscriptionLine[]

  @@map("taxes")
}

model Discount {
  id          String            @id @default(cuid())
  name        String
  type        DiscountType
  value       Decimal           @db.Decimal(12, 2)
  minPurchase Decimal?          @db.Decimal(12, 2)
  minQuantity Int?
  startDate   DateTime?
  endDate     DateTime?
  usageLimit  Int?
  usedCount   Int               @default(0)
  appliesTo   DiscountAppliesTo
  productId   String?
  product     Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  invoiceDiscounts InvoiceDiscount[]

  @@map("discounts")
}

model QuotationTemplate {
  id           String                  @id @default(cuid())
  name         String
  validityDays Int                     @default(30)
  planId       String
  plan         Plan                    @relation(fields: [planId], references: [id], onDelete: Restrict)
  lines        QuotationTemplateLine[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@map("quotation_templates")
}

model QuotationTemplateLine {
  id         String          @id @default(cuid())
  templateId String
  template   QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity   Int             @default(1)

  @@map("quotation_template_lines")
}

model Subscription {
  id                  String             @id @default(cuid())
  number              String             @unique
  customerId          String
  customer            User               @relation("CustomerSubscriptions", fields: [customerId], references: [id], onDelete: Restrict)
  planId              String
  plan                Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  startDate           DateTime
  expiryDate          DateTime
  paymentTerms        String             @default("IMMEDIATE")
  status              SubscriptionStatus @default(DRAFT)
  pausedAt            DateTime?
  nextBillingDate     DateTime
  lastBilledPeriodEnd DateTime?
  createdById         String
  createdBy           User               @relation("SubscriptionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  lines         SubscriptionLine[]
  statusHistory SubscriptionStatusHistory[]
  invoices      Invoice[]

  @@index([status, customerId, expiryDate, nextBillingDate])
  @@map("subscriptions")
}

model SubscriptionLine {
  id             String          @id @default(cuid())
  subscriptionId String
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity       Int             @default(1)
  unitPrice      Decimal         @db.Decimal(12, 2)
  taxId          String?
  tax            Tax?            @relation(fields: [taxId], references: [id], onDelete: SetNull)
  amount         Decimal         @db.Decimal(12, 2)

  @@map("subscription_lines")
}

model SubscriptionStatusHistory {
  id             String             @id @default(cuid())
  subscriptionId String
  subscription   Subscription       @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  fromStatus     SubscriptionStatus?
  toStatus       SubscriptionStatus
  changedById    String
  changedBy      User               @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  note           String?
  createdAt      DateTime           @default(now())

  @@map("subscription_status_histories")
}

model Invoice {
  id             String        @id @default(cuid())
  number         String        @unique
  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  customerId     String
  customer       User          @relation("CustomerInvoices", fields: [customerId], references: [id], onDelete: Restrict)
  status         InvoiceStatus @default(DRAFT)
  periodStart    DateTime
  periodEnd      DateTime
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  subtotal       Decimal       @db.Decimal(12, 2)
  taxTotal       Decimal       @db.Decimal(12, 2)
  discountTotal  Decimal       @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0.00) @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lines     InvoiceLine[]
  discounts InvoiceDiscount[]
  payments  Payment[]

  @@unique([subscriptionId, periodStart])
  @@index([status, customerId, dueDate])
  @@map("invoices")
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  taxPercent  Decimal  @db.Decimal(12, 2)
  taxAmount   Decimal  @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)

  @@map("invoice_lines")
}

model InvoiceDiscount {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Restrict)
  amount     Decimal  @db.Decimal(12, 2)

  @@map("invoice_discounts")
}

model Payment {
  id           String        @id @default(cuid())
  invoiceId    String
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  method       PaymentMethod
  amount       Decimal       @db.Decimal(12, 2)
  paidAt       DateTime      @default(now())
  note         String?
  recordedById String
  recordedBy   User          @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt    DateTime      @default(now())

  @@index([invoiceId, paidAt])
  @@map("payments")
}

model Counter {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("counters")
}
